# URL base do backend (services/), rodando localmente durante o desenvolvimento.
# Ajuste conforme onde o app está rodando:
#   - Simulador iOS:        http://localhost:3000
#   - Emulador Android:     http://10.0.2.2:3000  (localhost do host não é visível ao emulador)
#   - Dispositivo físico / Expo Go: http://<IP-da-sua-máquina-na-rede-local>:3000
#
# Copie este arquivo para .env (não versionado) e ajuste o valor.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
