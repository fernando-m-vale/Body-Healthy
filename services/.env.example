# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Matches the postgres service in docker-compose.yml
DATABASE_URL="postgresql://bodyhealthy:bodyhealthy@localhost:5432/body_healthy?schema=public"

PORT=3000

# Secret de assinatura dos JWTs de sessão (Spec 00) — gere um valor próprio por ambiente,
# ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret"

# S3 (Spec 01) — MinIO local por enquanto (docker-compose). Matches the minio
# service in docker-compose.yml. Trocar por S3 real depois é só mudar estas
# variáveis, a API é a mesma.
S3_ENDPOINT="http://localhost:9000"
# Endpoint usado SÓ para assinar URLs que um cliente externo (app mobile) vai
# usar diretamente — precisa ser alcançável a partir do celular/simulador, não
# só da própria máquina. Sem isso, cai para S3_ENDPOINT (funciona pra
# curl.exe/simulador iOS local, mas não pra celular físico/emulador Android).
# Mesmo IP de rede local já usado em apps/.env (EXPO_PUBLIC_API_BASE_URL).
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="body-healthy"
S3_ACCESS_KEY_ID="bodyhealthy"
S3_SECRET_ACCESS_KEY="bodyhealthy-minio"

# API da Anthropic (Spec 01, extração de exame laboratorial via IA) — gere em
# console.anthropic.com, idealmente num workspace isolado do de outros produtos.
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"

# Criptografia em nível de campo (Spec 04) — KEK local para dev. Em produção,
# KEY_PROVIDER=kms (AWS KMS, ainda não implementado nesta fase).
# Gere um valor próprio por ambiente:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_PROVIDER="local"
LOCAL_MASTER_KEY="replace-with-a-random-base64-256-bit-key"
